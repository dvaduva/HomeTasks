# Flask settings
FLASK_APP=wsgi.py
# Set to 'production' for deploy; 'development' for local development
FLASK_ENV=production
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here_change_this_in_production

# Database (default: SQLite in data/ folder)
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost/hometasks
DATABASE_URL=sqlite:///./data/hometasks.db

# Weather API settings (free key from openweathermap.org)
WEATHER_API_KEY=your_openweathermap_api_key

# Ollama AI settings
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3:8b
OLLAMA_TIMEOUT=120

# Application settings
DEFAULT_LANGUAGE=ro
TEMPERATURE_UNIT=C
UPDATE_INTERVAL_MINUTES=30

# Voice settings
VOICE_ACTIVATION_WORD=Hey HomeTasks
VOICE_DEBUG_LOG=1

# Tuya Cloud - eu.platform.tuya.com
TUYA_ACCESS_ID=your_access_id
TUYA_ACCESS_SECRET=your_access_secret
TUYA_API_REGION=eu

# Google Cast (radio cast to Chromecast / Google Home / Mi Smart Speaker).
# LAN-reachable URL of this HomeTasks instance, used when a stream is proxied to
# the speaker. Must be a real LAN IP/host the speaker can reach — never localhost.
# If unset, the host from the incoming request is used.
CAST_PUBLIC_BASE_URL=http://192.168.1.50:5000