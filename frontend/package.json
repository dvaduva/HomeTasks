    "vue-i18n": "^9.13.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@pinia/testing": "^0.1.7",
    "@types/node": "^25.8.0",
    "@vitejs/plugin-vue": "^5.1.0",
    "@vitest/coverage-v8": "^2.1.9",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.5.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.0.0"
  }
