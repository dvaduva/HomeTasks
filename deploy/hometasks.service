[Unit]
Description=HomeTasks - Family Task Manager
After=network.target

[Service]
User=pi
Group=pi
WorkingDirectory=/home/pi/hometasks
Environment="PATH=/home/pi/hometasks/venv/bin"
EnvironmentFile=/home/pi/hometasks/.env
ExecStart=/home/pi/hometasks/venv/bin/gunicorn --config deploy/gunicorn.conf.py wsgi:app
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
